#include <iostream>
using namespace std;
int main() {
    int rows;
    cout << "Enter the number of rows: ";
    cin >> rows;

    for (int i = 0; i < rows; i++) {
        int num = 1;
        for (int j = 0; j < rows - i - 1; j++) {
            std::cout << " ";
        }
        for (int j = 0; j <= i; j++) {
            std::cout << num << " "; 
            num = num * (i - j) / (j + 1);
        }
        cout <<endl; 
    }
    return 0;
}
