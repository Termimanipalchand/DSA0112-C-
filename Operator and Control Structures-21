#include <iostream>
using namespace std;
int main() {
    int number;
    cout << "Enter a number: ";
    cin >> number;
    if (number % 7 == 0 || number % 10 == 7) {
        cout << number << " is a Buzz number." << endl;
    } else {
        cout << number << " is not a Buzz number." << endl;
    }
    return 0;
}
