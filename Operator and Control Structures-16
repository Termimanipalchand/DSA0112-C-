#include <iostream>
using namespace std;
int main() {
    int a, b;
    cout << "Enter two positive integers: ";
    cin >> a >> b;
    if (a <= 0 || b <= 0) {
        cout << "Please enter positive integers." << endl;
        return 1;
    }
    int originalA = a;
    int originalB = b;
    do {
        if (a > b) {
            a -= b;
        } else {
            b -= a;
        }
    } while (a != b);
    cout << "The GCD of " << originalA << " and " << originalB << " is: " << a << endl;
    return 0;
}
