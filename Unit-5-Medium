#include <iostream>
#include <string>

using namespace std;

class Person {
protected:
    double salary;

public:
    virtual void getdata() {
        cout << "Enter the salary: ";
        while (!(cin >> salary) || salary < 0) {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "Invalid input, please enter a valid salary: ";
        }
    }

    virtual void displaydata() {
        cout << "Salary: " << salary << endl;
    }

    virtual double calculateBonus() {
        return salary * 1.02;
    }
};

class Admin : virtual public Person {  // Use virtual inheritance
public:
    void getdata() override {
        Person::getdata();
    }

    void displaydata() override {
        Person::displaydata();
    }

    double calculateBonus() override {
        return salary * 1.03;
    }
};

class Account : virtual public Person {  
public:
    void getdata() override {
        Person::getdata();
    }

    void displaydata() override {
        Person::displaydata();
    }

    double calculateBonus() override {
        return salary * 1.05;
    }
};

class Master : public Admin, public Account {
public:
    void getdata() override {
        Admin::getdata(); 
    }

    void displaydata() override {
        Admin::displaydata();  
    }

    double calculateBonus() override {
        return Admin::calculateBonus();  
    }
};

int main() {
    Person* employee;
    Master master;

    employee = &master;
    employee->getdata();
    employee->displaydata();
    cout << "Bonus = " << employee->calculateBonus() << endl;

    return 0;
}

