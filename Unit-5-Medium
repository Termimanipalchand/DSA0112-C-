#include <iostream>
using namespace std;

class Bank {
public:
    virtual float getRateOfInterest() = 0;  
};

class SBI : public Bank {
public:
    float getRateOfInterest() override {
        return 10.0f;  
    }
};

class ICICI : public Bank {
public:
    float getRateOfInterest() override {
        return 12.0f; 
    }
};

class AXIS : public Bank {
public:
    float getRateOfInterest() override {
        return 9.5f; 
    }
};

float calculateSimpleInterest(float principal, float rate, int years) {
    return (principal * rate * years) / 100;
}

int main() {
    float principal;
    int years;
    int bank_choice;

    cout << "Enter the principal Amount: ";
    if (!(cin >> principal) || principal <= 0) {
        cout << "Invalid principal amount." << endl;
        return 1;
    }

    cout << "Enter the No. of years: ";
    if (!(cin >> years) || years <= 0) {
        cout << "Invalid number of years." << endl;
        return 1;
    }

    cout << "Choose Bank (1 for SBI, 2 for ICICI, 3 for AXIS): ";
    if (!(cin >> bank_choice) || (bank_choice < 1 || bank_choice > 3)) {
        cout << "Invalid bank choice." << endl;
        return 1;
    }

    Bank* bank;
    switch (bank_choice) {
        case 1:
            bank = new SBI();
            break;
        case 2:
            bank = new ICICI();
            break;
        case 3:
            bank = new AXIS();
            break;
    }

    float rate = bank->getRateOfInterest();
    float simpleInterest = calculateSimpleInterest(principal, rate, years);

    cout << "Simple Interest: " << simpleInterest << endl;

    delete bank;
    return 0;
}
