#include <iostream>
using namespace std;

class Shape {
public:
    virtual void calculateArea() = 0;  
};

class Rectangle : public Shape {
protected:
    double length, breadth;

public:
    Rectangle(double l, double b) : length(l), breadth(b) {}

    void calculateArea() override {
        if (length <= 0 || breadth <= 0) {
            cout << "Invalid dimensions for a rectangle." << endl;
        } else {
            double area = length * breadth;
            cout << "Area of rectangle: " << area << endl;
        }
    }
};

class Cuboid : public Rectangle {
private:
    double height;

public:
    Cuboid(double l, double b, double h) : Rectangle(l, b), height(h) {}

    void calculateVolume() {
        if (length <= 0 || breadth <= 0 || height <= 0) {
            cout << "Invalid dimensions for a cuboid." << endl;
        } else {
            double volume = length * breadth * height;
            cout << "Volume of cuboid: " << volume << endl;
        }
    }
};

int main() {
    double length, breadth;

    cout << "Enter length: ";
    if (!(cin >> length)) {
        cout << "Invalid input for length." << endl;
        return 1;
    }

    cout << "Enter breadth: ";
    if (!(cin >> breadth)) {
        cout << "Invalid input for breadth." << endl;
        return 1;
    }

    if (length <= 0 || breadth <= 0) {
        cout << "Invalid dimensions for a rectangle." << endl;
        return 1;
    }

    Rectangle rect(length, breadth);
    rect.calculateArea();

    double height = 10; 
    Cuboid cub(length, breadth, height);
    cub.calculateVolume();

    return 0;
}

